#!/bin/bash

STREAMER_MODE=$(cat $HOME/streamermode)

if [[ $STREAMER_MODE = "disabled" ]]
then
    SAVEDIR="$HOME/.config/nitrogen_backup_/"
else
    SAVEDIR="$HOME/.config/nitrogen_backup/"
fi

pushd $HOME/.config/nitrogen > /dev/null

if [[ $1 = "list" ]]
then
    list=$(ls -I bg-saved.cfg -I nitrogen.cfg)
    last_theme=""
    count=0
    mod3=0

    for name in $list
    do
        count=$((count + 1))

        if [[ $name =~ ^profile-${last_theme}-([0-9]+)$ ]]
        then
            continue;

        elif [[ $name =~ ^profile-(.+)-([0-9]+)$ ]]
        then
            theme="${BASH_REMATCH[1]}"
            last_theme=$theme
            max_index=0

            for name_2 in $list
            do
                if [[ $name_2 =~ ^profile-${theme}-([0-9]+)$ ]]
                then
                    index=${BASH_REMATCH[1]}
                    if ((index > max_index))
                    then
                        max_index=$index
                    fi
                fi
            done

            printf "[%02u] %-20s" "$max_index" "$theme"

            if (( $mod3 == 2 ))
            then
                mod3=0
                printf "\n"
            else
                mod3=$((mod3 + 1))
            fi

        elif [[ $name =~ ^profile-(.+)$ ]]
        then
            theme="${BASH_REMATCH[1]}"
            printf "     $theme"
        fi
    done

    printf "\nTotal theme count: %u.\n" $count
    exit 0;

elif [[ $1 = "save" ]]
then
    if [[ $2 = "" ]]
    then
        echo -e "\n\033[31;1;1mERROR: no name specified to save theme as.\033[0m\n"
        exit 1;
    elif [[ -f "profile-$2" ]] || [[ -f "$SAVEDIR/profile-$2" ]]
    then
        echo "configuration exists."
        read -p "Do you wish to overwrite profile-$2? (y/N): " -r
        if [[ ! $REPLY =~ ^[Yy]$ ]]
        then
            echo -e "aborted."
            exit 2;
        fi
    fi

    cp "bg-saved.cfg" "profile-$2"
    cp "bg-saved.cfg" "$SAVEDIR/profile-$2"
    echo -e "saved current configuration as 'profile-$2' in:"
    echo -e "$HOME/.config/nitrogen/ \nand\n$SAVEDIR"

elif [[ $1 = "delete" ]] || [[ $1 = "remove" ]]
then
    if [[ $2 = "" ]]
    then
        echo -e "\n\033[31;1;1ma no configuration specified.\033[0m\n"
        exit 1;
    elif [[ ! -f "profile-$2" ]] && [[ ! -f "$SAVEDIR/profile-$2" ]]
    then
        echo -e "\033[31;1;1mERROR: a configuration of name '$2' does not exist.\033[0m\n"
        exit 1;
    fi

    rm "profile-$2"
    rm "$SAVEDIR/profile-$2"
    echo -e "successfully deleted configuration 'profile-$2' from:"
    echo -e "$HOME/.config/nitrogen/ \nand\n$SAVEDIR"

elif [[ $1 = "what" ]] || [[ $1 = "which" ]]
then
    if [[ -f $HOME/nitrogentheme ]]
    then
        cat $HOME/nitrogentheme
    else
        echo "unknown"
    fi

else
    if [[ $1 = "random" ]]
    then
        theme=$(ls -I bg-saved.cfg -I nitrogen.cfg | shuf -n 1)
    else
        theme="profile-$1"
    fi

    if [[ ! -f $theme ]] && [[ -f "$theme-0" ]]
    then
        count=0

        for curr in $theme-*
        do
            count=$((count + 1))
        done

        final=$(seq $count | shuf -n 1)
        theme="$theme-$((final - 1))"

    elif [[ ! -f $theme ]]
    then
        echo -e "\033[31;1;1mERROR: a configuration of name '$1' does not exist.\033[0m\n"
        popd > /dev/null
        exit 1;
    fi

    cp $theme bg-saved.cfg
    echo "${theme##profile-}" > $HOME/nitrogentheme
    echo "set theme: ${theme##profile-}"
fi

nitrogen --restore 2> /dev/null &
popd > /dev/null
