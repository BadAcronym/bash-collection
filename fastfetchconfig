#!/bin/bash

configFolder="$HOME/.config/fastfetch/"
configFolder=$(realpath $configFolder)

#WIP: finish these
#   delete -name-
#   save   -name-

if [[ $1 = "list" ]]
then
    for name in $(find $configFolder)
    do
        name="${name##*/}"
        echo "${name%.jsonc}"
    done

elif [[ $1 = "edit" ]]
then
    if [[ $2 = '' ]]
    then
        echo "editing current configuration..."
        nvim "$configFolder/config.jsonc"
    else
        echo "editing '$2'"
        nvim "$configFolder/$2.jsonc"
    fi

elif [[ $1 = "delete" ]]
then
    echo "TODO:"
    echo "removed $2.jsonc."

elif [[ $1 = "save" ]]
then
    echo "TODO:"
    echo "saved current config as $2.jsonc."

else
    #TODO: test if path actually exists
    pushd $configFolder
    cp "$1.jsonc" "config.jsonc"
    fastfetch
fi
