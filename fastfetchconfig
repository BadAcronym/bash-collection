#!/bin/bash

STREAMER_MODE=$(cat $HOME/streamermode)

if [[ $STREAMER_MODE = "disabled" ]]
then
    SAVEDIR="$HOME/.config/fastfetch_backup_/"
else
    SAVEDIR="$HOME/.config/fastfetch_backup/"
fi

pushd $HOME/.config/fastfetch/ > /dev/null

if [[ $1 = "list" ]]
then
    list=$(ls -I config.jsonc)
    last_theme=""
    count=0
    mod3=0

    for name in $list
    do
        count=$((count + 1))

        if [[ $name =~ ^${last_theme}-([0-9]+).jsonc$ ]]
        then
            continue;

        elif [[ $name =~ ^(.+)-([0-9]+).jsonc$ ]]
        then
            theme="${BASH_REMATCH[1]}"
            last_theme=$theme
            max_index=0

            for name_2 in $theme*
            do
                if [[ $name_2 =~ ^${theme}-([0-9]+).jsonc$ ]]
                then
                    index=${BASH_REMATCH[1]}
                    if ((index > max_index))
                    then
                        max_index=$index
                    fi
                fi
            done

            printf "[%02u] %-18s" "$max_index" "$theme"

            if (( $mod3 == 2 ))
            then
                mod3=0
                printf "\n"
            else
                mod3=$((mod3 + 1))
            fi

        else
            echo "     ${name%.jsonc}"
        fi
    done

    echo -e "\nTotal theme count: $count.\n"
    exit 0;

elif [[ $1 = "edit" ]]
then
    echo "editing current configuration..."
    nvim "config.jsonc"

    fastfetch

elif [[ $1 = "delete" ]] || [[ $1 = "remove" ]]
then
    if [[ $2 = "" ]]
    then
        echo -e "\n\033[31;1;1ma no configuration specified.\033[0m\n"
        exit 1;
    elif [[ ! -f "$2.jsonc" ]] && [[ ! -f "$SAVEDIR/$2.jsonc" ]]
    then
        echo -e "\033[31;1;1mERROR: a configuration of name '$2' does not exist.\033[0m\n"
        exit 1;
    fi

    rm "$2.jsonc"
    rm "$SAVEDIR/$2.jsonc"
    echo -e "successfully deleted configuration '$2' from:"
    echo -e "$HOME/.config/fastfetch/ \nand\n$SAVEDIR"

elif [[ $1 = "save" ]]
then
    if [[ $2 = "" ]]
    then
        echo -e "\n\033[31;1;1mERROR: no name specified to save theme as.\033[0m\n"
        exit 1;
    elif [[ -f "$2.jsonc" ]] || [[ -f "$SAVEDIR/$2.jsonc" ]]
    then
        echo "configuration exists."
        read -p "Do you wish to overwrite $2.jsonc? (y/N): " -r
        if [[ ! $REPLY =~ ^[Yy]$ ]]
        then
            echo -e "aborted."
            exit 2;
        fi
    fi

    cp "config.jsonc" "$2.jsonc"
    cp "config.jsonc" "$SAVEDIR/$2.jsonc"
    echo -e "saved current configuration as '$2.jsonc' in:"
    echo -e "$HOME/.config/fastfetch/ \nand\n$SAVEDIR"

elif [[ $1 = "what" ]] || [[ $1 = "which" ]]
then
    if [[ -f $HOME/fastfetchtheme ]]
    then
        cat $HOME/fastfetchtheme
    else
        echo "unknown"
    fi

else
    if [[ $1 = "random" ]]
    then
        theme=$(ls -I config.jsonc | shuf -n 1)

    elif [[ ! -f "$1.jsonc" ]] && [[ -f "$1-0.jsonc" ]]
    then
        theme=$1
        count=0

        for curr in $theme-*
        do
            count=$((count + 1))
        done

        final=$(seq $count | shuf -n 1)
        theme="$theme-$((final - 1)).jsonc"

    elif [[ $1 != "" ]] && [[ ! -f "$1.jsonc" ]]
    then
        echo -e "\033[31;1;1mERROR: a configuration of name '$1' does not exist.\033[0m\n"
        exit 1;

    else
        theme="$1.jsonc"
    fi

    if [[ $1 != "" ]]
    then
        cp $theme "config.jsonc"
        echo ${theme%%.jsonc} > $HOME/fastfetchtheme
    fi

    fastfetch
fi

popd > /dev/null
