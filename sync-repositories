#!/bin/bash

folders=()

function update()
{
    if [[ ! -d $1 ]]
    then
        echo "Already up to date."
        return;
    fi

    cd $1

    if [[ ! -d "./.git/" ]] && [[ ! -f "./.git" ]]
    then
        echo "Already up to date."
        return;
    fi

    PIDs=()
    i=0
    for submodule in ./vendor/*
    do
        if [[ ! -d $submodule ]]
        then
            continue;
        fi

        update $submodule &
        PIDs[$i]=$!
        i=$((i + 1))
    done

    for pid in ${PIDs[*]}
    do
        wait $pid
    done

    git fetch

    if [[ $? != 0 ]]
    then
        echo -e "^^^^^^ $1\n"
        return;
    fi

    git pull

    if [[ $? != 0 ]]
    then
        echo -e "^^^^^^ $1\n"
    fi
}

function update_all()
{
    PIDs=()
    i=0

    for folder in ${folders[@]}
    do
        update $folder &
        PIDs[$i]=$!
        i=$((i + 1))
    done

    for pid in ${PIDs[*]}
    do
        wait $pid
    done
}

folders=("$HOME/repository/aphelion-engine/")
folders+=("$HOME/repository/bash-collection/")
folders+=("$HOME/repository/blazeterm/")
folders+=("$HOME/repository/datasurf/")
folders+=("$HOME/repository/dotfiles/")
folders+=("$HOME/repository/dropfetch/")
folders+=("$HOME/repository/flushback/")
folders+=("$HOME/repository/fontflow/")
folders+=("$HOME/repository/gitfluss/")
folders+=("$HOME/repository/imgsurf/")
folders+=("$HOME/repository/islescape/")
folders+=("$HOME/repository/marino/")
folders+=("$HOME/repository/puddle/")
folders+=("$HOME/repository/pwsh-collection/")
folders+=("$HOME/repository/river2D/")
folders+=("$HOME/repository/river2D_mapedit/")
folders+=("$HOME/repository/river3D/")
folders+=("$HOME/repository/vertstream/")

update_all
