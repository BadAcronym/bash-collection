#!/bin/bash

folders=()
PIDs=()

function update()
{
    if [[ ! -d $1 ]]
    then
        echo "Already up to date."
        return;
    fi

    cd $1

    if [[ ! -d "./.git/" ]] && [[ ! -f "./.git" ]]
    then
        echo "Already up to date."
        return;
    fi

    git fetch

    if [[ $? != 0 ]]
    then
        echo -e "^^^^^^ $1\n"
        return;
    fi

    git pull

    if [[ $? != 0 ]]
    then
        echo -e "^^^^^^ $1\n"
    fi
}

function update_all()
{
    i=0
    for folder in ${folders[@]}
    do
        update $folder &
        PIDs[$i]=$!
        i=$((i + 1))
    done

    for pid in ${PIDs[*]}
    do
        wait $pid
    done
}

