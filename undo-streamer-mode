#!/bin/bash

read -p "ARE YOU SURE YOU WANT TO TURN OFF STREAMER MODE? (y/N): " -r

echo

if [[ $REPLY =~ ^[Yy]$ ]]
then
    pushd ~/.config/nitrogen_backup/ > /dev/null
    dir="$HOME/.config/nitrogen/"

    for config in profile*
    do
        if [[ ! -f $config ]]
        then
            continue;
        fi

        mv $config $dir
    done

    nitrogen-profile random

    pushd ~/.config/fastfetch_backup/ > /dev/null
    dir="$HOME/.config/fastfetch/"

    for config in *.jsonc
    do
        if [[ ! -f $config ]]
        then
            continue;
        fi

        mv $config $dir
    done

    fastfetchconfig random

    popd > /dev/null
    popd > /dev/null

else
    exit 1
fi
